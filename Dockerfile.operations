FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY product_data_collector product_data_collector
COPY domeggook_API domeggook_API
COPY ownerclan_API ownerclan_API
COPY coupang_API coupang_API
COPY naver_API naver_API
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
STOPSIGNAL SIGTERM
ENTRYPOINT ["python", "-m", "product_data_collector.operations"]
CMD ["plan", "--config", "product_data_collector/operations/example.yaml"]
